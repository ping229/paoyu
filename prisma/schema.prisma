// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 用户表
model User {
  id                  String              @id @default(uuid()) // 真码
  username            String              @unique // 用户名
  passwordHash        String              // 密码哈希
  intercode           String              @unique // 交互码
  intercodeUpdatedAt  DateTime            @default(now())
  createdAt           DateTime            @default(now())
  isBanned            Boolean             @default(false)

  // 关联
  sentMessages        MessageSet[]        @relation("SentMessages")
  receivedMessages    MessageSet[]        @relation("ReceivedMessages")
  intercodeHistory    IntercodeHistory[]
  blocksMade          Block[]             @relation("BlockedBy")
  blocksReceived      Block[]             @relation("BlockedUser")
  scheduledTasks      ScheduledTask[]
  reportsMade         Report[]            @relation("Reporter")
  reportsReceived     Report[]            @relation("Reported")
  comments            Comment[] @relation("UserComments")
  likes               Like[]
  timeMails           TimeMail[]
  bubbleReadStatus    BubbleReadStatus[]
  travelerRecord      TravelerRecord?
}

// 交互码变更历史
model IntercodeHistory {
  id          String   @id @default(uuid())
  userId      String
  oldCode     String
  newCode     String
  changedAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 信息集
model MessageSet {
  id            String    @id @default(uuid())
  senderId     String
  receiverId   String
  createdAt    DateTime  @default(now())
  isRead       Boolean   @default(false)
  isDeleted    Boolean   @default(false) // 接收方是否删除
  isPublic     Boolean   @default(false)
  publicAt     DateTime? // 公开时间
  scheduledAt  DateTime? // 定时发送时间
  isCommentReply Boolean @default(false) // 是否是评论回复通知
  commentMessageSetId String? // 关联的公共频道信息集ID

  sender       User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver     User      @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  messages     Message[]
  report       Report?
  comments     Comment[]
  likes        Like[]
  readStatus   BubbleReadStatus[]
}

// 单条消息
model Message {
  id            String    @id @default(uuid())
  messageSetId  String
  type          String    // text, image, voice
  content       String    // 文字内容或文件路径
  order         Int       // 顺序

  messageSet    MessageSet @relation(fields: [messageSetId], references: [id], onDelete: Cascade)
}

// 屏蔽
model Block {
  id              String    @id @default(uuid())
  blockerId       String    // 屏蔽者的真码
  blockedId       String    // 被屏蔽者的真码
  messageSetId    String?   // 屏蔽时依据的信息集ID
  messageSummary  String    // 信息集摘要
  createdAt       DateTime  @default(now())

  blocker         User      @relation("BlockedBy", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUser     User      @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)
}

// 定时任务
model ScheduledTask {
  id            String    @id @default(uuid())
  senderId      String
  receiverId    String?   // 真码，如果是站内发送
  targetEmail   String?   // 外部邮箱
  scheduledAt   DateTime
  isSent        Boolean   @default(false)
  isPublic      Boolean   @default(false)
  messageSetId  String?   // 关联的信息集

  sender        User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

// 举报
model Report {
  id            String    @id @default(uuid())
  reporterId    String
  reportedId    String    // 被举报者真码
  messageSetId  String    @unique
  reason        String?
  status        String    @default("pending") // pending, valid, invalid
  createdAt     DateTime  @default(now())

  reporter      User      @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported      User      @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)
  messageSet    MessageSet @relation(fields: [messageSetId], references: [id], onDelete: Cascade)
}

// 评论
model Comment {
  id            String    @id @default(uuid())
  messageSetId  String
  userId        String?
  content       String
  replyToId     String?   // 回复的评论ID
  isAIComment   Boolean   @default(false) // 是否是 AI 评论
  aiConfigId    String?   // 关联的 AI 配置ID
  createdAt     DateTime  @default(now())

  messageSet    MessageSet @relation(fields: [messageSetId], references: [id], onDelete: Cascade)
  user          User?     @relation("UserComments", fields: [userId], references: [id], onDelete: SetNull)
  replyTo       Comment?  @relation("CommentReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies       Comment[] @relation("CommentReplies")
}

// 点赞
model Like {
  id            String    @id @default(uuid())
  messageSetId  String
  userId        String
  createdAt     DateTime  @default(now())

  messageSet    MessageSet @relation(fields: [messageSetId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageSetId, userId]) // 每个用户对每个信息集只能点赞一次
}

// 管理员
model Admin {
  id            String    @id @default(uuid())
  username      String    @unique
  passwordHash  String
  createdAt     DateTime  @default(now())
  logs          AdminLog[]
}

// 管理员操作日志
model AdminLog {
  id          String    @id @default(uuid())
  adminId     String
  action      String    // 操作类型
  targetId    String?   // 目标ID
  details     String?   // 详细信息
  createdAt   DateTime  @default(now())

  admin       Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

// 系统配置
model SystemConfig {
  id            String    @id @default(uuid())
  key           String    @unique
  value         String
  updatedAt     DateTime  @updatedAt
}

// 时光邮件
model TimeMail {
  id            String    @id @default(uuid())
  senderId      String?   // 发送者ID（登录用户）
  senderName    String    // 发送者显示名称
  senderEmail   String?   // 发送者邮箱（可选，用于回复）
  toEmail       String    // 收件人邮箱
  subject       String    // 邮件主题
  content       String    // 邮件内容
  scheduledAt   DateTime  // 预定发送时间
  isSent        Boolean   @default(false)
  sentAt        DateTime? // 实际发送时间
  retryCount    Int       @default(0) // 重试次数
  lastError     String?   // 最后一次错误信息

  // 新增字段
  status        String    @default("approved") // pending/approved/rejected/sent/failed/resent
  isPublic      Boolean   @default(true)      // 是否公开到公共频道
  publicAt      DateTime?                     // 公开时间 = min(发送时间, 创建时间+1个月)
  deletedAt     DateTime?                     // 删除时间
  deleteReason  String?                       // 删除原因/管理员留言
  reviewedAt    DateTime?                     // 审核时间
  reviewedBy    String?                       // 审核管理员ID

  createdAt     DateTime  @default(now())

  sender        User?     @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([isSent, scheduledAt]) // 优化查询：未发送且到期的邮件
  @@index([status, scheduledAt]) // 优化查询：审核状态和发送时间
}

// AI 配置
model AIConfig {
  id            String    @id @default(uuid())
  name          String    // AI 名称（显示在评论中）
  apiUrl        String    // API 端点
  apiKey        String    // API 密钥
  model         String    // 模型名称（如 gpt-3.5-turbo）
  maxTokens     Int       @default(500)    // 最大回复长度
  temperature   Float     @default(0.7)    // 温度参数
  systemPrompt  String?   // 自定义系统提示词
  isActive      Boolean   @default(true)   // 是否启用
  priority      Int       @default(0)      // 优先级（数字越小越优先）
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  logs          AILog[]
}

// AI 调用日志
model AILog {
  id              String    @id @default(uuid())
  aiConfigId      String
  messageSetId    String    // 触发的信息集ID
  messageContent  String    // 触发的信息集内容摘要
  aiResponse      String?   // AI 回复内容
  status          String    // success / failed
  errorMessage    String?   // 错误信息
  duration        Int?      // 响应时间（毫秒）
  createdAt       DateTime  @default(now())

  aiConfig        AIConfig  @relation(fields: [aiConfigId], references: [id], onDelete: Cascade)

  @@index([aiConfigId, createdAt]) // 优化查询
}

// 泡泡阅读状态
model BubbleReadStatus {
  id            String    @id @default(uuid())
  userId        String
  messageSetId  String
  hasRead       Boolean   @default(false)  // 是否已阅读
  hasCommented  Boolean   @default(false)  // 是否已评论
  readAt        DateTime? // 阅读时间
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageSet    MessageSet @relation(fields: [messageSetId], references: [id], onDelete: Cascade)

  @@unique([userId, messageSetId]) // 每个用户对每个泡泡只有一条记录
  @@index([userId, hasRead]) // 优化查询：用户的未读泡泡
}

// 旅人录 - 用户公开卡片
model TravelerRecord {
  id            String    @id @default(uuid())
  userId        String    @unique
  travelerId    String?   @unique // 旅人ID（随机数字编号，进入集会后生成）
  title         String    // 称号 (2-20字)
  description   String?   // 描述 (0-200字)
  isPublic      Boolean   @default(true) // 是否在集会展示
  titleBanned   Boolean   @default(false) // 称号是否被封禁
  descBanned    Boolean   @default(false) // 描述是否被封禁
  titleBanCount Int       @default(0) // 称号被封禁次数
  descBanCount  Int       @default(0) // 描述被封禁次数
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  banHistory    TravelerBanHistory[]

  @@index([isPublic]) // 优化查询：公开的旅人录
  @@index([travelerId]) // 优化查询：旅人ID
}

// 旅人录封禁历史
model TravelerBanHistory {
  id            String    @id @default(uuid())
  recordId      String    // 旅人录ID
  banType       String    // title / desc
  originalContent String  // 被封禁的原始内容
  adminId       String    // 执行封禁的管理员ID
  createdAt     DateTime  @default(now())

  record        TravelerRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId, createdAt]) // 优化查询
}

// 称号词库 - 形容词
model TitleAdjective {
  id            String    @id @default(uuid())
  word          String    @unique
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

// 称号词库 - 名词
model TitleNoun {
  id            String    @id @default(uuid())
  word          String    @unique
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
}
